SECRET_KEY=replace-with-a-long-random-secret-key
MANAGER_SEED_PASSWORD=replace-with-official-location-1-password
MANAGER2_SEED_PASSWORD=replace-with-official-location-2-password
ADMIN_SEED_PASSWORD=replace-with-official-admin-password
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# NOTE:
# - The app reads manager credentials from MANAGER_SEED_PASSWORD and manager2 from MANAGER2_SEED_PASSWORD.
# - The admin account is created as 'admin' and uses ADMIN_SEED_PASSWORD.
# - Do not commit a real .env file to GitHub. Keep official credentials in your local deployment environment.
